{
  "name": "@forthtilliath/preact-toc",
  "version": "0.1.0",
  "description": "Headless hook to auto-generate a scrollspy table of contents from your page's headings, for Preact.",
  "type": "module",
  "main": "./dist-lib/index.cjs",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js",
      "require": "./dist-lib/index.cjs"
    }
  },
  "files": ["dist-lib"],
  "sideEffects": false,
  "keywords": [
    "preact",
    "toc",
    "table-of-contents",
    "scrollspy",
    "navigation",
    "hooks",
    "headings"
  ],
  "author": "Forthtilliath",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Forthtilliath/preact-toc.git"
  },
  "homepage": "https://github.com/Forthtilliath/preact-toc#readme",
  "bugs": {
    "url": "https://github.com/Forthtilliath/preact-toc/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "preact": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "tsup",
    "prepublishOnly": "npm run build:lib",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.8.2",
    "@types/node": "^20.14.10",
    "autoprefixer": "^10.4.19",
    "highlight.js": "^11.10.0",
    "marked": "^13.0.2",
    "postcss": "^8.4.39",
    "preact": "^10.22.0",
    "preact-router": "^4.1.2",
    "tailwind-variants": "^0.2.1",
    "tailwindcss": "^3.4.4",
    "tailwindcss-animate": "^1.0.7",
    "tsup": "^8.3.5",
    "typescript": "^5.2.2",
    "vite": "^5.3.1"
  }
}
